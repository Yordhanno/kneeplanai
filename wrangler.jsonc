{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kneeplanai",
  "compatibility_date": "2026-08-24",
  "main": "worker-auth.js",
  "vars": {
    "ADMIN_EMAIL": "yordano97@gmail.com",
    "ADMIN_AUTH_ALIASES": "yordhanno.fallaque@icloud.com",
    "APPLE_SERVICE_ID": "com.yordhannofallaque.kneeplanai.research",
    "APPLE_ACCESS_CALLBACK": "https://nameless-sunset-e994.cloudflareaccess.com/cdn-cgi/access/callback",
    "APPLE_BRIDGE_CALLBACK": "https://kneeplanai.com/auth/apple/callback"
  },
  "d1_databases": [
    {
      "binding": "RESEARCH_DB",
      "database_name": "kneeplanai-research",
      "database_id": "eba06bd4-d7fe-4ae8-a8c1-7962bae8d2fe"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
